DASHSCOPE_VISION_MODEL=qwen3-vl-plus
# Seedream 5.0 Pro image editing through Volcano Ark.
ARK_API_KEY=your-volcano-ark-api-key-here
# Optional Seedream overrides.
SEEDREAM_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
SEEDREAM_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
